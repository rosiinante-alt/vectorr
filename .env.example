# Copy to .env.local and fill in from your Supabase project settings.
# Supabase Dashboard → Project Settings → API

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row-Level Security — never expose or commit this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute origin used to build the magic-link redirect and post-login redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Frontend feature flag: set to "true" once the optimization endpoint ships.
# The UI uses it to offer real optimization instead of the local estimate.

# Replicate API — powers vectorization, upscaling, and background removal.
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your-token-here

# Polar — payments and credit purchases. See PAYMENTS_SETUP.md.
# Dashboard → Settings → API. Needs products:read and checkouts:write.
POLAR_ACCESS_TOKEN=polar_oat_your-token-here
# Signing secret of the `order.paid` / `subscription.*` webhook. The endpoint
# must be configured with the "Raw" payload format.
POLAR_WEBHOOK_SECRET=whsec_your-secret-here
# `production` or `sandbox`.
POLAR_SERVER=sandbox

# Product IDs from the Polar dashboard. The credit amount for each product lives
# in src/lib/payments/products.ts; a product left empty is simply not offered
# for sale. Keys must match the catalog exactly.
POLAR_PRODUCT_ONE_TIME_CREDITS=
POLAR_PRODUCT_STARTER_MONTHLY=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_TEAM_STARTER_MONTHLY=
POLAR_PRODUCT_TEAM_PRO_MONTHLY=
POLAR_PRODUCT_STARTER_ANNUAL=
POLAR_PRODUCT_PRO_ANNUAL=
POLAR_PRODUCT_TEAM_STARTER_ANNUAL=
POLAR_PRODUCT_TEAM_PRO_ANNUAL=
