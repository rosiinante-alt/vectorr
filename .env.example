# Copy to .env.local and fill in from your Supabase project settings.
# Supabase Dashboard → Project Settings → API

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row-Level Security — never expose or commit this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute origin used to build the magic-link redirect and post-login redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
